{
  "expo": {
    "name": "Plucky",
    "slug": "FitTrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.jjerner.fittrack",
      "adaptiveIcon": {
        "backgroundColor": "#ffd23f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Plucky uses the camera to scan food barcodes.",
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2563eb"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8d32b01f-665b-4298-bd0e-6611a579e829"
      }
    },
    "owner": "jjerner",
    "updates": {
      "url": "https://u.expo.dev/8d32b01f-665b-4298-bd0e-6611a579e829"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
